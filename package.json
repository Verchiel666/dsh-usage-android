{
  "name": "dsh-usage-android",
  "version": "0.1.1",
  "description": "Android 版 DSH 没有 Web Client 层，官方 Web 面板类用量插件在手机上渲染不出来；本插件把「会话 token 用量统计」做成 host 侧工具：总量、输入/输出/缓存命中、按天 sparkline、Top 会话、可选成本估算。纯只读。",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {},
  "engines": {
    "dsh": ">=0.2.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh-android",
    "usage",
    "tokens",
    "session",
    "observability",
    "no-webclient"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capabilities": [
      "tools:register",
      "fs:read"
    ],
    "labels": []
  }
}
